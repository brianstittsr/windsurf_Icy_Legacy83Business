# Environment Configuration
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=development

# ============================================================================
# SUPABASE CONFIGURATION (EasyPanel)
# ============================================================================
# Get these values from your EasyPanel Supabase instance

# Supabase API Configuration
# Access your Supabase dashboard via EasyPanel and go to Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-easypanel-domain.com/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Direct Connection (for migrations and server-side operations)
# Format: postgresql://postgres:password@host:port/database
# Internal (if deploying within EasyPanel): postgresql://postgres:password@supabasevp-db:5432/postgres
# External (if running locally): postgresql://postgres:password@your-domain.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@supabasevp-db:5432/postgres

# ============================================================================
# LEGACY FIREBASE CONFIGURATION (Optional - for migration)
# ============================================================================
# Keep these if you're migrating from Firebase, otherwise can be removed
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ============================================================================
# INTEGRATIONS
# ============================================================================

# UserWay Accessibility Widget
# Get your account ID from https://userway.org/dashboard
NEXT_PUBLIC_USERWAY_ACCOUNT_ID=

# Mattermost Integration
# Get webhook URL from Mattermost > Integrations > Incoming Webhooks
MATTERMOST_WEBHOOK_URL=

# ============================================================================
# SMTP EMAIL CONFIGURATION
# ============================================================================

# Legacy 83 Business Email (Office 365)
LEGACY83_SMTP_HOST=smtp.office365.com
LEGACY83_SMTP_PORT=587
LEGACY83_SMTP_SECURE=false
LEGACY83_SMTP_USER=info@legacy83business.com
LEGACY83_SMTP_PASSWORD=your-email-password-here

# Gmail (Icy Williams)
# Note: For Gmail, you need to use an App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_SMTP_USER=williamsicy@gmail.com
GMAIL_SMTP_PASSWORD=your-gmail-app-password-here

# ============================================================================
# GOOGLE CALENDAR INTEGRATION
# ============================================================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# MICROSOFT / OFFICE 365 CALENDAR INTEGRATION
# ============================================================================
# Register app at: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ============================================================================
# APP URL (for OAuth callbacks)
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# NOTES
# ============================================================================
# NEXT_PUBLIC_* variables are exposed to the browser
# Variables without NEXT_PUBLIC_ prefix are server-side only
# Never commit .env.local to version control

OPENAI_API_KEY=your-api-key
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://xxxx.ngrok.io/v1
LLM_MODEL=default